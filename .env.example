# Cmir Environment Configuration Example
# Copy this file to .env on the production server (never commit .env to Git)

# Environment mode: prod | lab | test
CMIR_ENV=prod

# Domain name for Caddy Reverse Proxy & Let's Encrypt SSL
DOMAIN=cmir.live
ACME_EMAIL=admin@cmir.live

# Production Security Keys (Generate with `openssl rand -hex 32`)
# Required: 64-character hex key (32 bytes) for AES biometric embedding encryption
CMIR_DATA_KEY=replace_with_openssl_rand_hex_32_in_production

# Required: Strong password for the admin panel (/admin.html)
CMIR_ADMIN_PASSWORD=replace_with_strong_admin_password

# Required: Shared secret token for the face-worker to communicate with the API
CMIR_WORKER_TOKEN=replace_with_secure_worker_token

# API Host and Port settings (within Docker network)
CMIR_HOST=0.0.0.0
CMIR_PORT=8090

# Storage paths
CMIR_DATA_DIR=/app/data

# Video stream URLs (defaults match internal Docker network & public Caddy proxy)
CMIR_RTMP=rtmp://cmir-mediamtx:1935
CMIR_RTSP=rtsp://cmir-mediamtx:8554
CMIR_HLS=https://cmir.live/hls
